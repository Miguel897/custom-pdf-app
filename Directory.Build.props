<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>PdfDesk</Product>
    <Company>miguel</Company>
    <Copyright>© 2026 Miguel</Copyright>
    <!-- The version comes from the latest vX.Y.Z git tag (MinVer); untagged commits get a pre-release
         version such as 0.1.2-alpha.0.3. Needs full history in CI (fetch-depth: 0). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Exact package versions recorded in packages.lock.json; CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Lock files also cover the win-x64 publish restore. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
