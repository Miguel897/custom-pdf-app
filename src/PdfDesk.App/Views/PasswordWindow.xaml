<Window x:Class="PdfDesk.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource ChromeBrush}">
    <StackPanel Margin="20" Width="340">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" />
        <TextBlock x:Name="RetryText" Text="The password is incorrect. Try again." Foreground="#B00020" Margin="0,6,0,0" Visibility="Collapsed" />
        <PasswordBox x:Name="Input" Margin="0,12,0,0" Padding="4,3" AutomationProperties.Name="Password" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
            <Button Content="Open" IsDefault="True" Padding="16,4" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
